<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- WinUI owns presentation; Windows Forms remains only for clipboard and input data interop. -->
    <DefaultXamlRuntime>WinUI</DefaultXamlRuntime>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>res\screenzap-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Opt-in: copy build output to a stable per-user install folder after build. -->
    <InstallAfterBuild>false</InstallAfterBuild>
    <StableInstallDir>$(LocalAppData)\Programs\Screenzap\</StableInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <ApplicationDefinition Update="App.xaml" XamlRuntime="WinUI" />
    <ProjectReference Include="..\TextDetection\TextDetection.csproj" />
    <ProjectReference Include="..\shared\Screenzap.Components.Shared\Screenzap.Components.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" Version="9.0.10" />
    <PackageReference Include="System.Reflection.Metadata" Version="9.0.10" />
    <!-- Windows ML comes from WindowsAppSDK; keep its managed and native ORT versions aligned. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Nito.AsyncEx" Version="5.1.0" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.0.20241108" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>true</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="SecurityRules.ruleset" />
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="ThirdParty\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Models\SwinIR-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Models\README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Models\swinir-jpeg10.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="res\screenzap-icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="res\screenzap0001_fav.ico" />
    <Content Include="res\zap.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="res\vtracer.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RequireDeJpegModel" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Models\swinir-jpeg10.onnx')" Text="De-JPEG model missing. Run tools/dejpeg/prepare.ps1 once before building." />
  </Target>

  <Target Name="InstallStableOutput" AfterTargets="Build" Condition="'$(InstallAfterBuild)' == 'true'">
    <ItemGroup>
      <StableInstallFiles Include="$(TargetDir)**\*" />
    </ItemGroup>

    <MakeDir Directories="$(StableInstallDir)" />

    <Copy
      SourceFiles="@(StableInstallFiles)"
      DestinationFiles="@(StableInstallFiles->'$(StableInstallDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Retries="2"
      RetryDelayMilliseconds="250" />

    <Message Importance="High" Text="Installed Screenzap build output to $(StableInstallDir)" />
  </Target>

  <!-- The SDK copies XAML resources for Build, but the unpackaged CLI publish pipeline
       must also include the app PRI and compiled XAML beside its native runtime. -->
  <Target Name="PublishNativeXamlResources" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The WinUI resource index is missing. Build before publishing." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri" RelativePath="$(AssemblyName).pri" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(TargetDir)App.xbf" RelativePath="App.xbf" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>